NEXT_PUBLIC_API_BASE_URL=

# Optional: legacy asset CDN base (DigitalOcean Spaces / S3)
NEXT_PUBLIC_SPACES_BASE_URL=

# Public origin of this app (password reset & OAuth redirects). Add the same URL in Supabase → Authentication → URL Configuration → Redirect URLs, e.g. http://localhost:3000/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key (same value; Supabase UI may label it "anon" or "publishable")
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: required for /api/admin BFF (createSupabaseAdminClient). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
