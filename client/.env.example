FORMSPREE_ENDPOINT=
NEXT_PUBLIC_CMS_TOKEN=

# Public admin dashboard URL (used for collator/player links).
NEXT_PUBLIC_ADMIN_URL=

# Optional: override Supabase storage public URL prefix.
NEXT_PUBLIC_STORAGE_URL=

# Base URL for sports/statistics API routes (e.g. /api/competition-types).
# Falls back to NEXT_PUBLIC_API_URL if unset.
NEXT_PUBLIC_SPORTS_API_URL=

# Base URL for CMS/content routes (e.g. /cms/news, /cms/videos).
# Falls back to NEXT_PUBLIC_API_URL if unset.
NEXT_PUBLIC_CMS_API_URL=

# Legacy shared API base; used as fallback for both sports and CMS URLs.
NEXT_PUBLIC_API_URL=

# Backward-compatible legacy var.
NEXT_PUBLIC_CMS_NEWS_ENDPOINT=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (used by Next.js server actions when reading Supabase directly).
SUPABASE_SERVICE_ROLE_KEY=
